{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "db-pickleball",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "SESSION_COOKIE_SECURE": "true",
    "NEON_AUTH_BASE_URL": "https://ep-dry-hall-b4rk3uy7.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth",
    "NEXT_PUBLIC_APP_URL": "https://db-pickleball.nathanglen.workers.dev"
  }
}
