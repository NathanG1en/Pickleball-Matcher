{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "db-pickleball",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "SESSION_COOKIE_SECURE": "true"
  }
}
