DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres
ORGANIZER_SESSION_SECRET=replace-with-at-least-32-random-bytes
PLAYER_SESSION_SECRET=replace-with-a-different-32-byte-random-secret
ORGANIZER_FINGERPRINT_SECRET=replace-with-a-different-32-byte-random-secret
SESSION_COOKIE_SECURE=false
SETUP_TOKEN=replace-with-a-one-time-setup-token
